#endif


xournalpp_core_lib = static_library(
    'xournalpp_core',
    sources : xournalpp_core_sources,
    dependencies : [xournalpp_defaults, xournalpp_util, xournalpp_external_modules]
    )

xournalpp_core = declare_dependency(
    link_with : xournalpp_core_lib,
    include_directories : '.'
)
